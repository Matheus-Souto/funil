# MODE=multi: domínio principal + um certificado curinga para *.PLATFORM_DOMAIN (lojas em <slug>.PLATFORM_DOMAIN).
# Certificado curinga só sai por desafio DNS, que exige um Caddy com o plugin do seu DNS (a imagem caddy:2 padrão não
# tem). Passo a passo em docs/instalacao.md ("Várias lojas"). Exemplo com Cloudflare: imagem de deploy/caddy-dns.Dockerfile
# e CLOUDFLARE_API_TOKEN (permissão Zone:DNS:Edit) no ambiente do serviço caddy.
#
# Não edite este arquivo (vem do git): para personalizar, copie para deploy/Caddyfile.local (fora do git) e use
# CADDYFILE=Caddyfile.local. Sem desafio DNS, use a lista fixa de lojas descrita em docs/instalacao.md ("Várias lojas").
{$DOMAIN} {
	# HSTS (1 ano): o navegador não volta a tentar http:// (rebaixamento na rede local justo na página do cartão). Fora
	# da lista de pré-carga dos navegadores por padrão (difícil de desfazer): entre nela depois de estável, se quiser.
	header Strict-Transport-Security "max-age=31536000"
	encode zstd gzip
	# Rota antiga do cartão (saiu do app): uma aba aberta antes da atualização ainda pode mandar o cartão para ela; os
	# bytes param aqui e nunca entram no processo do Next. Numa cópia Caddyfile.local, mantenha este bloco em todo site.
	@legacyCard {
		path /api/checkout/card
	}
	respond @legacyCard 404
	reverse_proxy app:3000
}

*.{$PLATFORM_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# HSTS (1 ano): o navegador não volta a tentar http:// (rebaixamento na rede local justo na página do cartão). Fora
	# da lista de pré-carga dos navegadores por padrão (difícil de desfazer): entre nela depois de estável, se quiser.
	header Strict-Transport-Security "max-age=31536000"
	encode zstd gzip
	# Rota antiga do cartão (saiu do app): uma aba aberta antes da atualização ainda pode mandar o cartão para ela; os
	# bytes param aqui e nunca entram no processo do Next. Numa cópia Caddyfile.local, mantenha este bloco em todo site.
	@legacyCard {
		path /api/checkout/card
	}
	respond @legacyCard 404
	reverse_proxy app:3000
}

# Cartão isolado: com CARD_ORIGIN definida, o compose monta deploy/Caddyfile.card como
# /etc/caddy/card/site.caddy; sem ela, como /etc/caddy/card/site, que este glob não pega (nenhum arquivo: o Caddy só
# avisa e sobe igual). Sem variável aqui de propósito: `{$X:padrão}` não usa o padrão com X vazia, e o compose passa
# vazia. Numa cópia Caddyfile.local, acrescente esta mesma linha no fim.
import card/*.caddy
