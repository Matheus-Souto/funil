{
  "name": "funil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/ && bash tests/verify/gate.test.sh && bash tests/verify/hook.test.sh && bash tests/verify/state.test.sh",
    "check": "bun run lint && bun run typecheck && bun run hygiene && bun run test",
    "migration": "drizzle-kit generate",
    "migrate": "bun src/lib/db/migrate.ts",
    "hygiene": "bun scripts/check-test-hygiene.ts",
    "verify": "bash scripts/verify.sh",
    "verify:reset": "rm -f .verify/state.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "typescript": "6"
  }
}
