{
  "name": "funil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/ && bash tests/verify/gate.test.sh && bash tests/verify/hook.test.sh && bash tests/verify/state.test.sh",
    "check": "bun run lint && bun run typecheck && bun run hygiene && bun run test",
    "migration": "drizzle-kit generate",
    "migrate": "bun src/lib/db/migrate.ts",
    "store:create": "bun scripts/store-create.ts",
    "store:domain": "bun src/cli/store-domain.ts",
    "asaas:unseal": "bun scripts/asaas-unseal.ts",
    "hygiene": "bun scripts/check-test-hygiene.ts",
    "verify": "bash scripts/verify.sh",
    "verify:reset": "rm -f .verify/state.json",
    "card:build": "bun build src/card-service/main.ts --target=node --outfile=dist/card/server.js && bun build src/card-service/form/form.ts --target=browser --format=iife --minify --outfile=dist/card/form.js && cp src/card-service/form/form.css dist/card/form.css && bun -e \"const c=require('node:crypto'),f=require('node:fs');f.writeFileSync('dist/card/form.js.sha256',c.createHash('sha256').update(f.readFileSync('dist/card/form.js')).digest('hex')+'\\n')\"",
    "card:dev": "bun run card:build && bun scripts/card-dev.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "lucide-react": "1.73.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "typescript": "6"
  }
}
