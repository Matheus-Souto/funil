# Postgres (compose.dev.yaml): `owner` é dono do banco e roda migrações; `app` é o papel da aplicação.
DATABASE_URL=postgres://app:app@localhost:5433/funil
OWNER_DATABASE_URL=postgres://owner:owner@localhost:5433/funil
APP_DB_PASSWORD=app

# E-mail de desenvolvimento (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Aplicação (obrigatórias: BASE_URL, DATABASE_URL, OWNER_DATABASE_URL, SECRET)
# single = uma loja; multi = várias lojas por subdomínio de PLATFORM_DOMAIN
MODE=single
# URL pública do app
BASE_URL=http://localhost:3000
# Domínio base das lojas (só no modo multi)
# PLATFORM_DOMAIN=
# Segredo de 32+ caracteres que deriva a chave de seal(). OBRIGATÓRIO e sem valor padrão: gere com
#   openssl rand -base64 48
# e cole abaixo (o app recusa valores de exemplo e vazio).
SECRET=
# Pasta de arquivos (produtos digitais, comprovantes)
DATA_DIR=./data
# Proxies reversos confiáveis na frente do app. OBRIGATÓRIA em produção (exceto BASE_URL em loopback).
# Deploy com Caddy: TRUST_PROXY=1 (o IP do comprador é a entrada mais à direita de X-Forwarded-For, a que o Caddy
# acrescenta; o HTTPS vem de X-Forwarded-Proto). 0 = sem proxy: X-Forwarded-For é ignorado (forjável), o IP fica
# "unknown" (sem limite por IP; valem e-mail e cartão) e nenhuma requisição conta como HTTPS (só loopback paga com cartão).
# TRUST_PROXY=1
# Turnstile (CAPTCHA) opcional
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Só fora de produção: aponta o cliente para o Asaas falso do smoke (recusada com NODE_ENV=production)
# ASAAS_BASE_URL=http://localhost:4010
