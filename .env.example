# Postgres (compose.dev.yaml): `owner` é dono do banco e roda migrações; `app` é o papel da aplicação.
DATABASE_URL=postgres://app:app@localhost:5433/funil
OWNER_DATABASE_URL=postgres://owner:owner@localhost:5433/funil
APP_DB_PASSWORD=app

# E-mail de desenvolvimento (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
