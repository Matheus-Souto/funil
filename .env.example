# Postgres (compose.dev.yaml): `owner` é dono do banco e roda migrações; `app` é o papel da aplicação.
DATABASE_URL=postgres://app:app@localhost:5433/funil
OWNER_DATABASE_URL=postgres://owner:owner@localhost:5433/funil
APP_DB_PASSWORD=app

# E-mail de desenvolvimento (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Aplicação (obrigatórias: BASE_URL, DATABASE_URL, OWNER_DATABASE_URL, SECRET)
# single = uma loja; multi = várias lojas por subdomínio de PLATFORM_DOMAIN
MODE=single
# URL pública do app
BASE_URL=http://localhost:3000
# Domínio base das lojas (só no modo multi)
# PLATFORM_DOMAIN=
# Segredo de 32+ caracteres que deriva a chave de seal() (gere com: openssl rand -base64 48)
SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
# Pasta de arquivos (produtos digitais, comprovantes)
DATA_DIR=./data
# Proxies reversos confiáveis na frente do app (Caddy/nginx/Cloudflare). Em produção o checkout de cartão exige HTTPS,
# então rode atrás de um proxy TLS e defina TRUST_PROXY=1 (ou o número de proxies). Com N > 0 o IP do cliente é o
# N-ésimo endereço da direita em X-Forwarded-For e o esquema vem de X-Forwarded-Proto. Com 0 (padrão), o IP é o que o
# Next anota a partir do socket (X-Forwarded-For só é preenchido pelo Next se o cliente não mandou; sem proxy, um
# cliente pode forjá-lo) e nenhuma requisição conta como HTTPS (só loopback passa em produção).
# TRUST_PROXY=1
# Turnstile (CAPTCHA) opcional
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Só fora de produção: aponta o cliente para o Asaas falso do smoke (recusada com NODE_ENV=production)
# ASAAS_BASE_URL=http://localhost:4010
